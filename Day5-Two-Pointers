class Solution {
    public int[] twoSum(int[] arr, int target) {
        int sum = 0;
        int n = arr.length;
        for(int i=0;i<=n-2;i++){
            for(int j=i+1;j<=n-1;j++){
                if(arr[i]+arr[j]==target){
                    target=arr[i]+arr[j];
                    return new int[]{i,j};
                }
        
            }

        }
        return new int[]{-1,-1};
        
    }
}


BUBBLE SORT:
#include<iostream>
using namespace std;
int main(){
    int arr[5]={5,4,3,2,1};
    int n = 5;
    for(int i=0;i<n;i++){
        for(int j=0;j<=n-2;j++){
            if(arr[j]>arr[j+1]){
                swap(arr[j],arr[j+1]);
            }
        }
    }
    for(int i=0;i<n;i++){
        cout<<arr[i]<<" ";
    }
}


INSERION SORT:

#include<iostream>
using namespace std;
int main(){
    int arr[5]={5,4,3,2,1};
    int n = 5;
    for(int i=1;i<=n-1;i++){
        for(int j=i;j>0;j--){
            if(arr[j]<arr[j-1]){
                swap(arr[j],arr[j-1]);
            }
        }
    }
    for(int i=0;i<n;i++){
        cout<<arr[i]<<" ";
    }
}


