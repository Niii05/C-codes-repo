class Solution {
    public int[] twoSum(int[] arr, int target) {
        int sum = 0;
        int n = arr.length;
        for(int i=0;i<=n-2;i++){
            for(int j=i+1;j<=n-1;j++){
                if(arr[i]+arr[j]==target){
                    target=arr[i]+arr[j];
                    return new int[]{i,j};
                }
        
            }

        }
        return new int[]{-1,-1};
        
    }
}