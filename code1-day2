#include<iostream>
using namespace std;
//copy constructor
class Student{
    //properties
    string name;
    int age;
    int roll_no;
    
    public:
    Student(string n,int a , int r){
        name =n;
        age =a;
        roll_no = r;
    }
    Student(Student &a){
        name = a.name;
        age = a.age;
        roll_no = a.roll_no;
        cout<< name<<" "<<age<<" "<<roll_no;
    }
    
};
int main(){
    Student  obj1("nandini", 21 , 449);
    Student obj2(obj1);
    
}


Q2. WAP for encapsulation and abstraction in C++

#include<iostream>
using namespace std;
//encapsulation & abstraction
class Student{
    //properties
    string name;
    int age;    //encapsulation
    public:
    void setter(string n , int a){
        name = n;
        age =a;
    }
    
      int getter(){
        return age;
    }
    
    void display(){
        cout<<name<<" "<<age;
    }
    ~Student(){
        cout<<"destructor called ";
    }
    
};
int main(){
    Student obj1;
    obj1.setter("nandini",21);
    cout<<obj1.getter();
    return 0;
    
}
