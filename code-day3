Q2. WAP for Function overloading(compile time).

#include<iostream>
using namespace std;
//func overloading
class Student{
  int length;
  int breath;
  public:
  int area(int l , int b){
      return l*b;
  }
  int area(int side){
      return (side*side);
  }
};
int main(){
    Student obj;
    cout<<"Area of Rectangle is: "<<obj.area(3,4)<<endl;
    cout<<"Area of square is: "<<obj.area(4)<<endl;
    
}

