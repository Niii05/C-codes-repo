Q1. Multiple Inheritance

#include<iostream>
using namespace std;
//Multiple inhertitance
class Human{
  protected:
  string name;
};
class Person{
    protected:
    int age;
};
class Student: public Human,public Person{
    int roll_no;
    public:
    Student(string n , int a, int r){
        name = n;
        age = a;
        roll_no = r;
    }
    void display(){
        cout<<name<<" "<<age<<" "<<roll_no;
    }

    
};
int main(){
    Student obj("Nandini",21,449);
    obj.display();
    return 0;
    
    
}