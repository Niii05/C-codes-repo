#include<iostream>
using namespace std;
void print(int i, int n){
    if(i==n+1){
        return;
    }
    cout<<2*i<<endl;
    print(i+1,n);
}
int main(){
    int n;
    cin>>n;
    int i=2;
    print(i,n);
}

Q2 WAP FOR SUM OF DISGIT USING RECURSION (JAVA)

class Solution {
    static int solve(int n, int sum)
    {
        if(n==0)
        return sum;
        
        int rem = n%10;
        sum += rem;
        return solve(n/10,sum);
    }
    static int sumOfDigits(int n) {
        // code here
        return solve(n,0);
    }
}


Q3. WAP for printing FACTORIAL USING RECURSION (JAVA)

class Solution {
    // Function to calculate factorial of a number.
    static int factorial(int n, int mul) {
        // code here
        if(n==1)
            return mul;
        mul = mul*n;
        return factorial(n-1,mul);
    }
        static int factorial(int n){
             return factorial(n, 1);
        }
