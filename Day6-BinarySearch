class Solution {
    public int search(int[] arr, int target) {
        int n = arr.length;
        int left =0;
        int right=n-1;
        while(left<=right){
            int mid = left+(right-left)/2;
            if(arr[mid]==target){
                return mid;
            }
            else if(arr[mid]<target){
                left =mid+1;
            }
            else{
                right = mid-1;
            }
        }

        return -1;       
    }
}


Q2. FInd First and Last Position

class Solution {
    public int[] searchRange(int[] arr, int target) {
        int first = -1;
        int last = -1;
        int left = 0;
        int right = arr.length-1;
        while(left<=right){
            int mid = left+(right-left)/2;
            if(arr[mid]==target){
                first = mid;
                right =mid-1;
            }
            else if(arr[mid]<target){
                left = mid+1;
            }
            else{
                right = mid-1;
            }
        }
        left =0;
        right = arr.length-1;
        while(left<=right){
            int mid= left+(right-left)/2;
            if(arr[mid]==target){
                last= mid;
                left =mid+1;
            }
            else if(arr[mid]>target){
                right= mid-1;
            }
            else{
                left =mid+1;
            }
        }
        return new int[] {first,last};

        
    }
}