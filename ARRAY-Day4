Q2. WAP for printing Oddsum and Evensum.

#include<iostream>
using namespace std;
int main(){
    int arr[5]={1,3,4,5,6};
    int i;
    int oddsum=0 , evensum=0;
    for(int i=0;i<=4;i++){
        if(i%2==0){
            oddsum = oddsum+arr[i];
        }
        else{
            evensum= evensum+arr[i];
        }
        cout<<"oddsum: "<<oddsum<<endl;
        cout<<"evensum: "<<evensum;
    }
    
}

Q3. WAP FOR REVERSING A ARRAY

#include<iostream>
using namespace std;
int main(){
    int arr[5]={1,3,4,5,6};
    int i=0,j=4;
    while(i<=j){
        swap(arr[i],arr[j]);
        i++;
        j--;
    }
    for(int k=0;k<=4;k++)
    cout<<arr[k]<<" ";
}