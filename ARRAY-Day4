Q. WAP for printing a basic array.
#include<iostream>
using namespace std;
int main(){
    int arr[5];
    int i;
    for(int i=0;i<=4;i++){
        cin>>arr[i];
        cout<<arr[i]<<" ";
    }
}


Q2. WAP for printing Oddsum and Evensum.

#include<iostream>
using namespace std;
int main(){
    int arr[5]={1,3,4,5,6};
    int i;
    int oddsum=0 , evensum=0;
    for(int i=0;i<=4;i++){
        if(i%2==0){
            oddsum = oddsum+arr[i];
        }
        else{
            evensum= evensum+arr[i];
        }
        cout<<"oddsum: "<<oddsum<<endl;
        cout<<"evensum: "<<evensum;
    }
    
}